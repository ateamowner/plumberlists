# Public site URL used in sitemap, robots, JSON-LD, and the form redirect.
NEXT_PUBLIC_SITE_URL=https://plumberlists.com

# Quote inbox. The static form posts to Formsubmit, which emails this address.
# No Node server or SMTP is required for the published site.
# Never send a lead to a contractor who is not on Anthony's approved payer list.
# There is no payer list in this repo, so the inbox is owner@ only.
LEADS_EMAIL=owner@ateamcontractings.com
